# Vehicle Risk Agent Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL + pgvector on local compose port 54329)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:54329/postgres

# Bearer Authentication Tokens (dev defaults)
REQUESTER_TOKEN=dev-requester-token
REVIEWER_TOKEN=dev-reviewer-token
OPERATOR_TOKEN=dev-operator-token
MAINTAINER_TOKEN=dev-maintainer-token

# Upstream Vehicle Intelligence MCP Server for the full-local Compose path
MCP_SERVER_URL=http://localhost:8080

# Optional hosted MCP override for compose.quickstart.yaml
# QUICKSTART_MCP_SERVER_URL=https://vehicle-mcp.chhlatbot.com/mcp

# Optional Live Evaluation Key
# ANTHROPIC_API_KEY=your-api-key-here
